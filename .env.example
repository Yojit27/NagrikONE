# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TINYFISH_API_KEY: Optional. Your TinyFish (tinyfish.ai) Agent API key for live web & Pinterest reverse search.
TINYFISH_API_KEY="MY_TINYFISH_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key.
# Client-side map rendering key.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Cloud SQL (PostgreSQL Developer Edition) runtime environment variables
# Injected automatically at runtime by AI Studio Cloud SQL Auth Proxy
SQL_HOST="/cloudsql"
SQL_DB_NAME="postgres"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD=""

# SMTP Email Delivery Provider (Gmail SMTP, Brevo, SendGrid, Amazon SES)
# To use Gmail SMTP:
# 1. Turn on 2-Step Verification in Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address in SMTP_USER and the 16-character App Password in SMTP_PASS
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="citizen_desk@example.com"
SMTP_PASS="YOUR_16_CHAR_GMAIL_APP_PASSWORD"
SMTP_FROM="Nagrik One Civic Portal <no-reply@nagrikone.gov.in>"

